{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for timetable app",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-appdata-write",
    "fs:allow-appdata-read",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" },
        { "path": "$DOCUMENT" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP" },
        { "path": "$DESKTOP/**" }
      ]
    },
    "dialog:default",
    "dialog:allow-save"
  ]
}