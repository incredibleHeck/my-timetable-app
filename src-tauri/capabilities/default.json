{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for timetable app",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-download-write-recursive",
    "dialog:default",
    "dialog:allow-save"
  ]
}