# Build outputs and dependencies — never useful as AI context.
node_modules/
dist/
src-tauri/target/

# Test and coverage artefacts — regenerated by `npm test` / `npm run test:e2e`.
coverage/
test-results/
playwright-report/

# Logs.
*.log

# Real school data — same rule as .gitignore. Never index, never send to a
# model. Synthetic fixtures (scripts/diagnostics/fixtures/school-data.json)
# stay visible; only the private ones are excluded.
scripts/diagnostics/fixtures/local/

# NOTE: config files (package.json, tsconfig*.json, tauri.conf.json,
# src-tauri/capabilities/*.json) are deliberately NOT ignored. They are small
# and they are exactly what most work in this repo touches.
#
# package-lock.json lives in .cursorindexingignore instead: too big to index,
# but still worth @-tagging by hand when checking a resolved dependency version.
